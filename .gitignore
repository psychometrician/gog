# This file starts by ignoring everything, then names what is public. A denylist
# fails open -- anything added later ships unless someone remembers to exclude
# it -- and git history cannot be unpublished. An allowlist fails closed instead:
# a new top-level path stays invisible until it is named here.
#
# Order matters: ignore all, allow the public paths, then re-ignore build output
# that lives inside them.

/*

# The engine, and its two bridges. `gog-cli` carries a request in on stdin;
# `gog-wasm` carries the identical JSON in over linear memory, which is what lets
# a web page render without a subprocess to spawn. Both are thin: the decoding,
# the legality gate and the renderer are `gog-core`'s.
!/gog-core/
!/gog-cli/
!/gog-wasm/

# The four bindings
!/r-pkg/
!/py-pkg/
!/js-pkg/
!/jl-pkg/

# The manual. It stays with the engine because every plot in it is drawn by
# `gog-cli` at render time, so one engine change invalidates every page at once.
!/book/

# The blog, which is here for the same reason and shares the book's setup: a
# post draws its plots with the engine built from this checkout, so it can show
# a feature before the feature is released. Named for the reason the header
# gives -- `git check-ignore -v blog/index.qmd` answers `/*`, and a directory
# left unnamed is invisible with no error at all. A `blog/.gitignore` could not
# rescue it either, since git will not re-include a file whose parent is
# excluded.
!/blog/

!/.github/

# The README's five language logos, normalized to one optical size. Named here
# because the allowlist above fails closed: without this line the directory is
# absent from the public tree and the README shows five broken images, which is
# a failure only a reader would see.
!/images/

# Root files
!/README.md
!/CHANGELOG.md
!/NEWS.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE
!/Cargo.toml
!/Cargo.lock
!/.gitattributes
!/.gitignore

# A scratch directory for local experiments, sitting beside `book/`. The `/*`
# above already hides it, so this line adds no enforcement. It is here to say
# the folder is deliberate rather than stray, and that it is never meant to
# ship -- which is worth writing down precisely because the allowlist makes
# every unnamed path look the same.
/test/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Rust
# `target/` is unanchored on purpose: `/target/` would miss a stray
# `gog-core/target/` left by a subdirectory build.
target/
**/*.rs.bk

# Cargo.lock is committed -- gog-cli is a binary crate, so the pinned versions
# are part of the build contract.

# Generated output
/output/
/js-pkg/gog/test/book_parity/translations.json
/jl-pkg/GrammarOfGraphics/test/book_parity/translations.json

# Only the *package's*. The parity harness beside it is an application rather
# than a package, so its Manifest is committed on purpose.
/jl-pkg/GrammarOfGraphics/Manifest.toml

# Quarto
/book/_book/
/book/.quarto/
/book/site_libs/
/book/_freeze/
/blog/_site/
/blog/.quarto/
/blog/site_libs/
/blog/_freeze/
**/*.quarto_ipynb

# Staged into `blog/` by its pre-render so Quarto can publish them beside the
# pages that fetch them: the browser engine, the two modules that drive it, and
# the book's stylesheet. Build output and a copy, not source.
/blog/gog.wasm
/blog/interactive.js
/blog/view.js
/blog/gog.css

# R
.Rproj.user/
.Rhistory
.RData
.Rapp.history
.Ruserdata
*.Rproj
*.Rcheck/
r-pkg/*.tar.gz

# All three are produced during a build rather than written by hand: `configure`
# copies the engine into inst/bin/ and the browser engine into inst/www/, and
# `.prepare` stages the crate sources into tools/rust/.
r-pkg/gog/inst/bin/
r-pkg/gog/inst/www/
r-pkg/gog/tools/rust/
# `.prepare` also stages the root NEWS.md, which `news(package = "gog")` reads
# from beside DESCRIPTION. One history, staged — never a second copy committed.
r-pkg/gog/NEWS.md

# The same, for the npm package: the release job compiles the browser engine and
# stages it here before `npm pack`. `package.json` lists `www` under `files` so
# the tarball carries it, and nothing here is written by hand.
js-pkg/gog/www/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
book/.venv/
dist/
build/
*.whl
.pytest_cache/

# JavaScript. This one needs saying out loud, because the allowlist above does
# not cover it: `/*` hides new paths at the *top level*, and `node_modules/`
# appears inside `/js-pkg/`, which is allowlisted. Nothing has installed it yet,
# so the day it first appears is the day it would otherwise be staged.
node_modules/

# OS / editor
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
*.bak
*.orig
