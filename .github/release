#!/usr/bin/env bash
# release — do every mechanical part of cutting a release, and stop at the parts
# that are decisions.
#
# `RELEASING.md` beside this file is the explanation; this is the execution. The
# two must agree, so if you change the sequence here, change it there.
#
#     .github/release --check       verify the tree without changing it
#     .github/release <version>     bump, regenerate, test, dispatch — then stop
#     .github/release --tag py      push py-v<version> → PyPI, after approval
#     .github/release --tag js      push js-v<version> → npm, after approval
#     .github/release --r           push main:release → r-universe, and sync it
#     .github/release --engines     build the Julia engines, before --julia
#     .github/release --julia notes.md
#                                   try the release copy, then register it in
#                                   General with the notes in notes.md
#     .github/release --ci          run CI on commits main has not published,
#                                   through a draft pull request
#
# `<version>` is the number you are moving *to*. The tree's current one is
# whatever `--check` prints; nothing here guesses at the next.
#
# **It never publishes anything on its own.** The bump command stops before the
# tags, because the packaging workflows it dispatches are worth reading before
# a number is spent. The tag commands push one ref each and then wait for you to
# approve an environment in the browser, which is where the irreversible step
# actually lives.
#
# What it deliberately cannot do: register the PyPI and npm trusted publishers.
# Both registries require a human in a browser for that, by design, because it
# is the step that authorizes a machine to publish as you.

set -euo pipefail

# rustup and juliaup edit the *interactive* shell's profile only, so a script
# has to put them on PATH itself or the regeneration step silently finds no
# cargo and the suites find no julia.
export PATH="$HOME/.cargo/bin:$HOME/.juliaup/bin:$PATH"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; green=$'\033[32m'; off=$'\033[0m'
step() { printf '%s▸ %s%s\n' "$bold" "$1" "$off"; }
ok()   { printf '  %s✓%s %s\n' "$green" "$off" "$1"; }
note() { printf '  %s%s%s\n' "$dim" "$1" "$off"; }
die()  { printf '%s✗ %s%s\n' "$red" "$1" "$off" >&2; exit 1; }

# The eight files that declare a version, and the five npm pins inside the
# ninth. `gog-wasm/Cargo.toml` is in the list because `.prepare` copies the crate
# into the R source tarball, so its number reaches a user's disk.
declared_version() { sed -n 's/^Version: *\(.*\) *$/\1/p' r-pkg/gog/DESCRIPTION | head -1; }

# --------------------------------------------------------------------------
# checks

check_clean_enough() {
  # Someone else may be working in this tree. Refuse only if the files this
  # script is about to rewrite already carry changes, rather than demanding a
  # spotless tree that never exists here.
  local dirty
  dirty="$(git diff --name-only -- \
    r-pkg/gog/DESCRIPTION py-pkg/gog/pyproject.toml py-pkg/gog/gog/__init__.py \
    js-pkg/gog/package.json jl-pkg/GrammarOfGraphics/Project.toml \
    gog-core/Cargo.toml gog-cli/Cargo.toml gog-wasm/Cargo.toml)"
  [ -z "$dirty" ] || die "these already have uncommitted changes, and this would overwrite them:
$dirty"
}

check_ci_green() {
  command -v gh >/dev/null || { note "gh not found — skipping the CI check"; return 0; }
  local sha status
  sha="$(git rev-parse HEAD)"
  status="$(gh run list --commit "$sha" --limit 20 \
    --json name,conclusion,status --jq \
    '[.[] | select(.name == "tests")] | if length == 0 then "none"
       elif any(.status != "completed") then "running"
       elif all(.conclusion == "success") then "green" else "red" end' 2>/dev/null || echo unknown)"
  case "$status" in
    green)   ok "CI is green at $(git rev-parse --short HEAD)" ;;
    none)    note "no tests run for $(git rev-parse --short HEAD) yet — push first, or accept the risk" ;;
    running) note "CI is still running at $(git rev-parse --short HEAD)" ;;
    red)     die "CI is red at $(git rev-parse --short HEAD). Fix that before releasing." ;;
    *)       note "could not read CI status" ;;
  esac
}

# The release branch waits for CI, at this exact commit. r-universe builds most of
# its targets on Linux, and a clean `R CMD check` on a Mac proved nothing about
# Linux at 0.4.0: a regex macOS's PCRE2 compiled stopped the suite on Ubuntu, and
# the local check had read Status: OK. `tests.yml`'s `installed` job is that check
# on Linux, so `--r` refuses unless it has run here and passed.
require_ci_green() {
  command -v gh >/dev/null || die "gh is needed to read CI before releasing R"
  local sha status
  sha="$(git rev-parse HEAD)"
  git fetch -q origin main || die "could not fetch origin/main"
  [ "$(git rev-parse origin/main)" = "$sha" ] ||
    die "HEAD $(git rev-parse --short HEAD) is not origin/main. Push main, let tests.yml run on it, then release."
  status="$(gh run list --commit "$sha" --limit 20 \
    --json name,conclusion,status --jq \
    '[.[] | select(.name == "tests")] | if length == 0 then "none"
       elif any(.status != "completed") then "running"
       elif all(.conclusion == "success") then "green" else "red" end' 2>/dev/null || echo unknown)"
  case "$status" in
    green) ok "tests.yml is green at $(git rev-parse --short HEAD), the installed job included" ;;
    *)     die "tests.yml is '$status' at $(git rev-parse --short HEAD). The release branch waits for it: its installed job is the r-universe check on Linux." ;;
  esac
}

check_versions_agree() {
  local want="$1" bad=0 got
  for spec in \
    "r-pkg/gog/DESCRIPTION:^Version: *\(.*\) *$" \
    "py-pkg/gog/pyproject.toml:^version = \"\(.*\)\"$" \
    "py-pkg/gog/gog/__init__.py:^__version__ = \"\(.*\)\"$" \
    "js-pkg/gog/package.json:^  \"version\": \"\(.*\)\",$" \
    "jl-pkg/GrammarOfGraphics/Project.toml:^version = \"\(.*\)\"$" \
    "gog-core/Cargo.toml:^version = \"\(.*\)\"$" \
    "gog-cli/Cargo.toml:^version = \"\(.*\)\"$" \
    "gog-wasm/Cargo.toml:^version = \"\(.*\)\"$"
  do
    local file="${spec%%:*}" pat="${spec#*:}"
    got="$(sed -n "s/$pat/\1/p" "$file" | head -1)"
    [ "$got" = "$want" ] || { printf '    %-42s %s\n' "$file" "${got:-(none)}"; bad=1; }
  done
  local pins
  pins="$(grep -c "\"grammar-of-graphics-[a-z0-9-]*\": \"$want\"" js-pkg/gog/package.json || true)"
  [ "$pins" = "5" ] || { printf '    %-42s %s of 5 pinned at %s\n' "js-pkg/gog/package.json" "$pins" "$want"; bad=1; }
  [ "$bad" = "0" ] || die "the thirteen declarations do not all read $want (above)"
  ok "all thirteen declarations read $want"
}

# --------------------------------------------------------------------------
# the work

bump() {
  local want="$1" now
  now="$(declared_version)"
  [ "$want" != "$now" ] || die "the tree already reads $want"
  printf '%s' "$want" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || die "expected X.Y.Z, got $want"

  step "Moving thirteen declarations from $now to $want"
  perl -i -pe "s/^Version: \Q$now\E\$/Version: $want/"                        r-pkg/gog/DESCRIPTION
  perl -i -pe "s/^version = \"\Q$now\E\"\$/version = \"$want\"/"              py-pkg/gog/pyproject.toml jl-pkg/GrammarOfGraphics/Project.toml gog-core/Cargo.toml gog-cli/Cargo.toml gog-wasm/Cargo.toml
  perl -i -pe "s/^__version__ = \"\Q$now\E\"\$/__version__ = \"$want\"/"      py-pkg/gog/gog/__init__.py
  perl -i -pe "s/^(  \"version\": )\"\Q$now\E\",\$/\$1\"$want\",/"            js-pkg/gog/package.json
  perl -i -pe "s/^(    \"grammar-of-graphics-[a-z0-9-]+\": )\"\Q$now\E\"(,?)\$/\$1\"$want\"\$2/" js-pkg/gog/package.json
  check_versions_agree "$want"
}

regenerate() {
  # Three tracked files carry the number without being checked, because a build
  # owns them. They go in the same commit as the bump: the push is what
  # r-universe builds from, and `.prepare` ships two of the three to R users, so
  # there is no later chance to correct the tarball it compiles.
  step "Regenerating the three files a build owns"
  cargo build --release >/dev/null 2>&1                      || die "cargo build failed"
  cargo build --release --target wasm32-unknown-unknown \
       --manifest-path gog-wasm/Cargo.toml >/dev/null 2>&1   || die "wasm build failed"
  julia --project=jl-pkg/GrammarOfGraphics/test/book_parity \
        -e 'using Pkg; Pkg.resolve()' >/dev/null 2>&1        || die "Pkg.resolve failed"

  # Prove they actually moved. A build that quietly did nothing leaves the old
  # number in place, and these three are exactly the files no guard reads.
  local want missing=""
  want="$(declared_version)"
  for f in Cargo.lock gog-wasm/Cargo.lock jl-pkg/GrammarOfGraphics/test/book_parity/Manifest.toml; do
    grep -q "\"$want\"" "$f" || missing="$missing $f"
  done
  [ -z "$missing" ] || die "these still do not carry $want, so the rebuild did not take:$missing"
  ok "Cargo.lock, gog-wasm/Cargo.lock, book_parity/Manifest.toml all read $want"
}

suites() {
  step "The four binding suites"
  Rscript r-pkg/gog/tests/test_basic.R    >/dev/null 2>&1 || die "the R suite failed"
  ok "R"
  python3 py-pkg/gog/tests/test_basic.py  >/dev/null 2>&1 || die "the Python suite failed"
  ok "Python"
  node --test js-pkg/gog/test/*.mjs       >/dev/null 2>&1 || die "the JavaScript suite failed"
  ok "JavaScript"
  julia --project=jl-pkg/GrammarOfGraphics \
        jl-pkg/GrammarOfGraphics/test/runtests.jl >/dev/null 2>&1 || die "the Julia suite failed"
  ok "Julia"
}

parity() {
  # Re-record first: the corpus is R's side, and a stale recording means every
  # other binding is measured against a book that no longer exists.
  step "Three parity harnesses, against a fresh recording"
  Rscript py-pkg/gog/tests/book_parity/extract.R >/dev/null 2>&1 || die "extract.R failed"
  local out
  for runner in \
    "python3 py-pkg/gog/tests/book_parity/run.py" \
    "node js-pkg/gog/test/book_parity/run.mjs" \
    "julia --project=jl-pkg/GrammarOfGraphics/test/book_parity jl-pkg/GrammarOfGraphics/test/book_parity/run.jl"
  do
    out="$($runner 2>&1)" || die "a parity run failed: ${runner%% *}"
    grep -q "to look at" <<<"$out" && { grep -A3 "to look at" <<<"$out"; die "${runner%% *} reports disagreements"; }
    ok "$(awk '{print $1}' <<<"$runner") — $(grep -m1 'identical plot' <<<"$out" | tr -s ' ')"
  done
}

dispatch() {
  # Neither publishes. Both are otherwise reached only by `workflow_call` from a
  # release tag, so a break in them would first show itself on a tag, which is
  # the worst place to meet one.
  step "Dispatching the two packaging workflows (neither publishes)"
  command -v gh >/dev/null || { note "gh not found — dispatch these by hand"; return 0; }
  gh workflow run python-wheels.yml --ref main >/dev/null 2>&1 && ok "python-wheels.yml" || note "could not dispatch python-wheels.yml"
  gh workflow run js-packages.yml   --ref main >/dev/null 2>&1 && ok "js-packages.yml"   || note "could not dispatch js-packages.yml"
}

# --------------------------------------------------------------------------
# tags, which are the irreversible half

push_tag() {
  local which="$1" version tag
  version="$(declared_version)"
  case "$which" in
    py) tag="py-v$version" ;;
    js) tag="js-v$version" ;;
    *)  die "expected 'py' or 'js', got '$which'" ;;
  esac
  check_versions_agree "$version"
  git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "$tag already exists locally"
  [ -z "$(git ls-remote --tags origin "$tag")" ] || die "$tag already exists on the remote"

  step "About to push $tag, which starts a real publish"
  note "the version job checks all thirteen declarations and asks the registry"
  note "whether $version is taken, before building anything — a mismatch is free"
  printf '  type the tag to confirm: '
  read -r typed
  [ "$typed" = "$tag" ] || die "not confirmed"

  git tag "$tag"
  git push origin "$tag"
  ok "pushed $tag"
  case "$which" in
    py) note "TestPyPI runs first and is not gated. Read it, then approve the 'pypi' environment." ;;
    js) note "Read the dry-run preflight, then approve the 'npm' environment." ;;
  esac
}

# r-universe tracks the `release` branch, not `main`, since 2026-08-28. A push to
# `main` reaches it not at all, and the failure is silent: it keeps serving the
# previous version with nothing to say why. Then ask for a sync rather than waiting
# — the dispatching metajob is meant to run hourly and measurably does not, with
# gaps of two to five hours observed on a day when nothing was wrong.
release_r() {
  local version out
  version="$(declared_version)"
  check_versions_agree "$version"
  require_ci_green
  step "Releasing gog $version to r-universe"
  git push origin main:release || die "could not push main:release"
  ok "release branch now at $(git rev-parse --short HEAD)"
  out="$(curl -s -X PATCH https://psychometrician.r-universe.dev/api/sync)" ||
    die "sync request failed; press the button in the universe sidebar"
  case "$out" in
    *html_url*) ok "sync started" ;;
    *) die "sync did not start: $out" ;;
  esac
  note "nine targets, each compiling the engine; about ten minutes"
  note "read every target when it lands, not the summary:"
  note "  curl -s https://psychometrician.r-universe.dev/api/packages/gog |"
  note "    python3 -c 'import sys,json;[print(j[\"config\"],j[\"check\"]) for j in json.load(sys.stdin)[\"_jobs\"]]'"
  note "wasm-release FAILs by design: webR has no Rust toolchain"
}

# The engines must exist before `Artifacts.toml` can name their URLs, and that file
# must be committed before the package is registered. Hanging the tarballs off the
# package's own release tag would make each need the other first.
build_engines() {
  local version
  version="$(declared_version)"
  check_versions_agree "$version"
  command -v gh >/dev/null || die "gh is needed to dispatch the workflow"
  step "Building the Julia engine artifacts for $version"
  gh workflow run julia-artifacts.yml -f version="$version" ||
    die "could not dispatch julia-artifacts.yml"
  ok "dispatched: five platforms, then a bind job that commits Artifacts.toml"
  note "when it finishes:  git pull    then  .github/release --julia"
}

# Below 1.0.0 the first nonzero component is the breaking one, so 0.3.0 → 0.4.0
# and 0.0.4 → 0.0.5 both break, and AutoMerge stops either unless the notes say
# what broke.
breaking_bump() {
  local a1 b1 c1 a2 b2 c2
  IFS=. read -r a1 b1 c1 <<<"$1"
  IFS=. read -r a2 b2 c2 <<<"$2"
  if [ "$a1" != 0 ] || [ "$a2" != 0 ]; then [ "$a1" != "$a2" ]; return; fi
  if [ "$b1" != 0 ] || [ "$b2" != 0 ]; then [ "$b1" != "$b2" ]; return; fi
  [ "$c1" != "$c2" ]
}

# A registration is permanent, so the copy General will serve is installed and
# drawn first: the package alone, from a directory with no checkout above it and
# no staged `assets/`, so the engine and the browser files can come only from the
# artifact `Artifacts.toml` names. 0.3.0 shipped a package whose browser half was
# in no place a released copy looks, while every check passed in a checkout.
probe_julia() {
  command -v julia >/dev/null || die "julia is needed to try the release copy before registering"
  local dir
  dir="$(mktemp -d)"
  cp -R jl-pkg/GrammarOfGraphics "$dir/GrammarOfGraphics"
  rm -rf "$dir/GrammarOfGraphics/assets"
  step "Installing the release copy, alone, and drawing from its artifact"
  (cd "$dir" && env -u GOG_CLI_PATH julia --startup-file=no -e '
    using Pkg
    Pkg.activate(mktempdir(); io = devnull)
    Pkg.develop(path = "GrammarOfGraphics"; io = devnull)
    Pkg.instantiate(; io = devnull)
    using GrammarOfGraphics
    const G = GrammarOfGraphics
    cli = G.find_gog_cli()
    www = G.find_wasm_assets()
    from_artifact = occursin("artifacts", cli) && www !== nothing &&
                    all(p -> occursin("artifacts", p), www)
    df = (a = [1.0, 2.0, 3.0], b = [3.0, 1.0, 2.0])
    drew = startswith(render_svg(data(df) + point + x(:a) + y(:b)), "<svg")
    turns = occursin("<script type=\"module\"",
                     G.html_of(data(df) + point + x(:a) + y(:b) + brush(:a, at = [1.5, 3])))
    println("  engine: ", cli)
    println("  browser files: ", www === nothing ? "none" : dirname(first(www)))
    (from_artifact && drew && turns) || exit(1)') ||
    { rm -rf "$dir"; die "the release copy did not draw and turn from its artifact; do not register it"; }
  rm -rf "$dir"
  ok "a copy with no checkout draws, and its brushed block carries the browser module"
}

trigger_julia() {
  local notes="${1:-}" version sha last body
  version="$(declared_version)"
  sha="$(git rev-parse HEAD)"
  check_versions_agree "$version"

  # **The notes go with the registration, every time.** Julia is the one registry
  # that asks what changed, and AutoMerge stops a breaking version whose notes do
  # not say. The comment used to go without them, so the breaking releases from
  # 0.0.2 to 0.4.0 were each registered by hand. The file is posted as it is.
  [ -n "$notes" ] && [ -s "$notes" ] ||
    die "give the release notes as a file: .github/release --julia notes.md (with a '## Breaking changes' section when the bump breaks)"
  git fetch -q origin main || die "could not fetch origin/main"
  [ "$(git rev-parse origin/main)" = "$sha" ] ||
    die "HEAD $(git rev-parse --short HEAD) is not origin/main; the registration names a commit GitHub has, so push first"
  git fetch -q --tags origin 2>/dev/null || true
  last="$(git tag -l 'GrammarOfGraphics-v*' --sort=-v:refname | head -1 | sed 's/^GrammarOfGraphics-v//')"
  if [ -z "$last" ] || breaking_bump "$last" "$version"; then
    grep -qi 'breaking' "$notes" ||
      die "${last:-the last registered version} → $version is breaking below 1.0.0, and AutoMerge stops it unless the notes say what broke: add a '## Breaking changes' section to $notes"
    ok "${last:-?} → $version is breaking, and the notes say what broke"
  fi

  # **The engines have to be there first, and nothing else would notice.** A
  # registration is permanent, and a registered tree with no `Artifacts.toml` — or
  # one naming a previous release's engines — gives every Julia reader a package
  # that installs, loads, and refuses on their first plot. That was the state of
  # this binding for its whole life before 0.3.0, so it is worth one grep.
  local toml="jl-pkg/GrammarOfGraphics/Artifacts.toml"
  [ -f "$toml" ] ||
    die "$toml is missing — run .github/release --engines, then git pull"
  grep -q "engine-v$version/" "$toml" ||
    die "$toml does not name engine-v$version; it has $(sed -n 's|.*/download/\(engine-v[^/]*\)/.*|\1|p' "$toml" | sort -u | tr '\n' ' ')— run --engines, then git pull"
  ok "$toml names engine-v$version on $(grep -c '^\[\[gog_cli\]\]' "$toml") platforms"

  probe_julia

  step "Registering GrammarOfGraphics $version from $(git rev-parse --short HEAD)"
  note "an existing package auto-merges with no three-day hold"
  command -v gh >/dev/null || die "gh is needed to post the comment"
  body="$(printf '@JuliaRegistrator register subdir=jl-pkg/GrammarOfGraphics\n\nRelease notes:\n\n%s\n' "$(cat "$notes")")"
  gh api "repos/psychometrician/gog/commits/$sha/comments" -f body="$body" >/dev/null \
     && ok "commented on $sha, with the notes in $notes" \
     || die "could not comment; post it by hand on the release commit"
  note "NEVER comment on the registration PR without the literal [noblock] —"
  note "a bare comment reads as an objection and sends it to manual review."
  note "TagBot writes GrammarOfGraphics-v$version once the registry PR merges."
}

# CI on commits `main` has not published. `tests.yml` runs on every pull request
# and `book.yml` only on a push to `main`, so a draft pull request from this branch
# runs every check, the Linux `installed` job included, and publishes nothing.
# At 0.4.0 `main` had held 208 commits back for eight days, and the release push
# was the first time CI saw two R failures written a day or two before it.
ci_preview() {
  command -v gh >/dev/null || die "gh is needed to open the draft pull request"
  local branch="ci/preview" url
  git fetch -q origin main || die "could not fetch origin/main"
  [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ] ||
    die "HEAD is origin/main already, so CI runs on main itself"
  git push -q -f origin "HEAD:refs/heads/$branch" || die "could not push $branch"
  ok "$branch is at $(git rev-parse --short HEAD), $(git rev-list --count origin/main..HEAD) commit(s) past main"
  url="$(gh pr view "$branch" --json url,state --jq 'select(.state == "OPEN") | .url' 2>/dev/null || true)"
  if [ -z "$url" ]; then
    url="$(gh pr create --draft --base main --head "$branch" \
      --title "CI preview: not for merging" \
      --body "Runs tests.yml on commits main has not published yet. Nothing publishes from here: the book, the packages and r-universe move only from main, tags and the release branch. Pushed again by the next preview.")" ||
      die "could not open the draft pull request"
  fi
  ok "draft pull request: $url"
  note "watch it:  gh pr checks $branch --watch"
  note "the branch is public, as main is: the same privacy rules apply"
}

# --------------------------------------------------------------------------

case "${1:-}" in
  --check)
    check_ci_green
    check_versions_agree "$(declared_version)"
    ok "tree reads $(declared_version)"
    ;;
  --tag)     push_tag "${2:-}" ;;
  --r)       release_r ;;
  --engines) build_engines ;;
  --julia)   trigger_julia "${2:-}" ;;
  --ci)      ci_preview ;;
  "" | -h | --help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"
    ;;
  *)
    want="$1"
    check_clean_enough
    check_ci_green
    bump "$want"
    regenerate
    suites
    parity
    dispatch
    printf '\n%sReady at %s. Nothing is published yet.%s\n\n' "$bold" "$want" "$off"
    note "review the diff, commit it, and push — a push to main does NOT release R"
    note "read both packaging runs before spending a number:"
    note "  gh run list --workflow=python-wheels.yml --limit 1"
    note "  gh run list --workflow=js-packages.yml   --limit 1"
    printf '\n  then, in order:\n'
    printf '    .github/release --tag py     %s→ PyPI, approve the pypi environment%s\n' "$dim" "$off"
    printf '    .github/release --tag js     %s→ npm, approve the npm environment%s\n' "$dim" "$off"
    printf '    .github/release --r          %s→ r-universe: push release, then sync%s\n' "$dim" "$off"
    printf '    .github/release --engines    %s→ the Julia engines; git pull after%s\n' "$dim" "$off"
    printf '    .github/release --julia notes.md  %s→ General, with its release notes%s\n\n' "$dim" "$off"
    ;;
esac
