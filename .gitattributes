# Line endings
#
# This project moved from Windows to macOS; every source file was CRLF.
# `eol=lf` normalizes on commit AND checkout, so the repo stays LF-only no
# matter which OS a contributor is on — including a future Windows machine.
* text=auto eol=lf

# Binary — never diff, never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Generated by `cargo run --example book_images` — collapse in GitHub diffs.
book/images/*.svg linguist-generated=true
