#!/bin/sh
# configure — put the engine in the package
#
# The R package is a bridge to a Rust binary, so an installed copy that cannot
# find that binary cannot draw anything. That was the recorded blocker on
# releasing this binding, and it had been true since
# the bridge was built: `R CMD INSTALL` succeeded and `render_svg()` then failed
# on a machine with no `target/`. The decision taken was to **ship the binary**,
# and this is R's half of it — the counterpart to `py-pkg/gog/hatch_build.py`,
# which force-includes the same executable into a wheel.
#
# Mechanically: put `gog-cli` at `inst/bin/`, which `R CMD INSTALL` copies to
# `<lib>/gog/bin/`, which is where `find_gog_cli()` looks second (after the
# `GOG_CLI_PATH` override and before `PATH`).
#
# Five ways the engine arrives, in the order they are tried:
#
#   1. already in `inst/bin/`  — a release tarball, prepared by CI, *and* no
#                                workspace beside the package (see step 1)
#   2. $GOG_CLI_PATH           — an engine built somewhere else
#   3. ../../target/{release,debug} — a development checkout
#   4. built from ../../       — the crate sources that traveled with the repo
#   5. built from tools/rust/  — the crate sources staged *inside* the package
#
# Step 4 is what makes `remotes::install_github(…, build = FALSE)` work. A GitHub
# tarball carries `gog-core/`, `gog-cli/`, `Cargo.toml` and `Cargo.lock` but not
# `target/` (it is gitignored), so before this step a GitHub install failed at
# step 3 — measured, not assumed. Building takes about ten seconds, which is why
# it is last: any engine already present is preferred over compiling one.
#
# `build = FALSE` is not optional there, and that too was measured (2026-09-21)
# rather than assumed. `remotes` defaults to `build = TRUE`, which runs
# `R CMD build` on the *subdirectory* before installing, and that tarball has the
# r-universe shape: no `../../`, and no `tools/rust/` either, because nothing ran
# `.prepare`. Steps 4 and 5 both miss and this script refuses. The refusal at the
# bottom recognizes that case from the `Remote*` fields `remotes` writes into
# DESCRIPTION before it builds, and names the argument — the fix is one word
# away and nothing in the generic message would lead a reader to it.
#
# Failing loudly when none of the five holds is the point. Installing a package
# that is guaranteed not to draw is the silent drop this project refuses
# everywhere else; §12 says a diagnostic must give direction, so this one does.
#
# Step 5 is what makes a **subdirectory build** work, and it is the one that r-universe
# needs. That farm clones the whole repository but then runs `R CMD build` on the
# `subdir` alone, so `../../` does not exist in the resulting tarball and steps 3
# and 4 both miss. `.prepare` runs before that build, in the full clone, and copies
# the crates to `tools/rust/` — a directory `R CMD build` ships and `R CMD INSTALL`
# does not try to compile. The same staging is what a CRAN submission needs, for a
# different reason: CRAN forbids shipping a binary *and* forbids network during a
# build, so the sources must travel and `.prepare`'s `GOG_VENDOR=1` brings the
# dependency crates with them.

set -e

# `configure.win` sources this file with the Windows name set, so the two
# platforms share one copy of the logic rather than two that can drift.
EXE="${GOG_EXE_NAME:-gog-cli}"
DEST="inst/bin"
WORKSPACE="../.."
STAGED="tools/rust"

# ---------------------------------------------------------------------------
# WebAssembly is not a platform this package can install on
# ---------------------------------------------------------------------------
#
# The package farm builds every package for WebAssembly as well as for the three
# desktop platforms, and that build is the one place the whole design of this
# bridge cannot reach. The R package draws by running `gog-cli` as a separate
# process; R compiled to WebAssembly has no way to start one. So there is no
# engine that could be bundled here, and no arrangement of the five sources
# below that ends in a package able to draw a plot. Refusing is the same ruling
# as the message at the bottom of this file: an install guaranteed not to draw
# is the silent drop this project refuses everywhere else.
#
# Refusing *here*, rather than after the search, also stops a cross-compile that
# cannot help. The farm's WebAssembly image replaces `cargo` with a shim that
# adds `--target=wasm32-unknown-emscripten` to any `cargo build` arriving
# without one, so step 5 below does compile the engine — and then writes
# `gog-cli.js` and `gog-cli.wasm` where this script looks for `gog-cli`. Fifty
# seconds of work, and nothing usable at the end of it.
#
# The cross-build announces itself the standard way, on the configure command
# line. `CC` is the fallback, for a caller that sets only the environment.
for _arg in "$@"; do
  case "${_arg}" in
    --host=*emscripten*) GOG_WASM_HOST=1 ;;
  esac
done
case "${CC}" in
  *emcc*) GOG_WASM_HOST=1 ;;
esac

if [ -n "${GOG_WASM_HOST}" ]; then
  echo "gog: this package cannot be built for WebAssembly." >&2
  echo "" >&2
  echo "It draws by running the gog-cli engine as a separate process, and R" >&2
  echo "compiled to WebAssembly cannot start one. There is no engine to bundle" >&2
  echo "for this target, and an install without one could not draw a plot." >&2
  echo "" >&2
  echo "gog is available for Linux, macOS and Windows." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Which Rust builds the engine
# ---------------------------------------------------------------------------
#
# Steps 4 and 5 below compile, and a compile needs a Rust at least as new as the
# crates declare. That floor is read from `gog-cli/Cargo.toml`'s `rust-version`
# rather than written here, so this script and the crates cannot disagree.
#
# **Every `cargo` within reach is asked, and the first one new enough builds.**
# On Linux the first `cargo` on `PATH` is often the distribution's, which can be
# older than the floor. The usual fix is rustup, which puts a current one in
# `~/.cargo/bin`, and taking the first `cargo` on `PATH` regardless would build
# with the old one again: the fix the message below gives would not work.
#
# `cargo` is looked for in `~/.cargo/bin` as well as on `PATH`, because rustup
# installs it there and adds it to the *interactive* shell's profile — which the
# non-interactive shell `R CMD INSTALL` runs has not read. Verified: `cargo` was
# absent from a plain `sh -c` on the development machine until that path was
# added by hand, so relying on `PATH` alone would fail for the common setup.
#
# **An old Rust is refused before it runs.** Left to try, it fails on whatever
# it meets first. Rust 1.75 given 0.4.0 stopped at `lock file version 4 requires
# -Znext-lockfile-bump`, which names neither the version it had nor the one it
# needed, and the message below then blamed `.prepare`. A version this script
# cannot read is not refused: the check exists to give direction, not to block
# a build that may work.

RUST_FLOOR=""   # the oldest Rust the crates declare, read by choose_cargo
CARGO_BIN=""    # the cargo that builds, once one is new enough
CARGO_PATH=""   # the PATH it builds with, so its own `rustc` is the one found
RUST_STATE=""   # none | old | ok once a build has asked; empty if none did
RUST_SEEN=""    # one line per cargo looked at, for the message at the bottom

# What a build printed, kept as well as shown, so the message at the bottom can
# tell a build the system stopped from one that failed on its own. A build runs
# inside a command substitution, so it hands this back as a file, not a variable.
BUILD_LOG="${TMPDIR:-/tmp}/gog-cargo-$$.log"
rm -f "${BUILD_LOG}"
trap 'rm -f "${BUILD_LOG}"' EXIT

# 1.75 and 1.75.0 both become 1075, so two versions compare as integers in sh.
# Anything that does not start with a number becomes 0, which means unknown.
rust_version_number() {
  echo "$1" | awk -F. '{ if ($1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+/) print $1 * 1000 + int($2); else print 0 }'
}

choose_cargo() {
  RUST_FLOOR="$(sed -n 's/^rust-version *= *"\([0-9.]*\)".*/\1/p' "$1/gog-cli/Cargo.toml" | head -n 1)"
  _need="$(rust_version_number "${RUST_FLOOR}")"
  CARGO_BIN=""
  CARGO_PATH=""
  RUST_STATE="none"
  RUST_SEEN=""
  _onpath="$(command -v cargo 2>/dev/null || true)"
  _prev=""
  for _cand in "${_onpath}" "${HOME}/.cargo/bin/cargo"; do
    [ -n "${_cand}" ] || continue
    [ "${_cand}" != "${_prev}" ] || continue
    _prev="${_cand}"
    # The `cargo` on `PATH` builds with `PATH` as it is, which is how it always
    # did. The one in `~/.cargo/bin` gets its directory put first, so the `rustc`
    # it runs, and the one asked for a version here, is rustup's beside it rather
    # than an older one earlier on `PATH`.
    if [ "${_cand}" = "${_onpath}" ]; then
      _path="${PATH}"
    else
      [ -x "${_cand}" ] || continue
      _path="$(dirname "${_cand}"):${PATH}"
    fi
    _rustc="$(PATH="${_path}" rustc --version 2>/dev/null | head -n 1)"
    _have="$(rust_version_number "$(echo "${_rustc}" | awk '{ print $2 }')")"
    RUST_SEEN="${RUST_SEEN}  ${_cand}: ${_rustc:-reported no rustc version}
"
    if [ "${_need}" -eq 0 ] || [ "${_have}" -eq 0 ] || [ "${_have}" -ge "${_need}" ]; then
      CARGO_BIN="${_cand}"
      CARGO_PATH="${_path}"
      RUST_STATE="ok"
      return 0
    fi
    RUST_STATE="old"
  done
  return 0
}

# Build `gog-cli` from a workspace manifest with the cargo `choose_cargo` picked,
# and report the binary's path on success, nothing on failure. Shared by steps 4
# and 5 so the two cannot drift in the flags they pass — `-j 1` in one and not the
# other would be a difference nobody would notice until a small machine failed.
build_engine() {
  _root="$1"
  [ -n "${CARGO_BIN}" ] || return 0

  echo "* gog: no prebuilt engine found — building it from ${_root}/." >&2
  PATH="${CARGO_PATH}" "${CARGO_BIN}" --version >&2 || true
  PATH="${CARGO_PATH}" rustc --version >&2 || true

  # **Build from inside the workspace, not with `--manifest-path` from outside.**
  # Cargo looks for `.cargo/config.toml` by walking up from the *working
  # directory*, not up from the manifest. `.prepare --vendor` writes that config
  # at `tools/rust/.cargo/config.toml`, which is *below* this script's directory,
  # so building from here would never find it and cargo would go to crates.io for
  # every dependency. On CRAN, where there is no network, that is a failed build.
  #
  # It looked fine locally for the worst possible reason: cargo's own cache in
  # `~/.cargo` already held the crates, so `--offline` succeeded without ever
  # consulting the vendor directory. Re-running with an empty `CARGO_HOME` is what
  # exposed it — `no matching package named 'serde' found`.
  #
  # A subshell keeps the directory change local, so the caller's relative paths
  # below still resolve.
  #
  # **`-j 1`, one crate at a time, because memory runs out before time does.**
  # CRAN asks for 1 or 2. At `-j 2` the compiler building `gog-core` peaked at
  # 854 MiB in one measurement, with `resvg` and `gif` compiling beside it, and
  # on Posit Cloud the system stopped it there (0.5.0). At `-j 1` it peaked at
  # 632 MiB with nothing beside it, and a machine with one processor builds no
  # slower.
  # `--locked` builds exactly the dependency versions the lockfile names, which
  # are the ones CI builds at the floor. A Cargo older than 1.84 that had to choose
  # versions itself would take the newest, whatever Rust they need.
  # `tee` keeps what cargo printed for the message at the bottom, which reads it
  # for a compiler the system stopped.
  # `|| true` because a build failure should reach the message at the bottom of
  # this script, which names every fix, rather than exiting on cargo's alone.
  ( cd "${_root}" && PATH="${CARGO_PATH}" "${CARGO_BIN}" build --release --locked -p gog-cli -j 1 ) 2>&1 \
    | tee "${BUILD_LOG}" >&2 || true

  # **Report nothing, but report it successfully.** The caller reads this
  # function through a command substitution — `FOUND="$(build_engine …)"` — and
  # under `set -e` an assignment whose substitution exits non-zero ends the
  # script right there. A bare `[ -f … ] && echo …` as the last command does
  # exactly that whenever the build produced no binary, which made the
  # diagnostic at the bottom of this file, the one naming every fix,
  # unreachable in the single case it was written for. What a reader saw
  # instead was `ERROR: configuration failed for package ‘gog’` and no reason.
  if [ -f "${_root}/target/release/${EXE}" ]; then
    echo "${_root}/target/release/${EXE}"
  fi
  return 0
}

# 1. A release tarball already carries it — and *already carries it* has to be
#    told apart from *has a leftover from the last install*, which this step could
#    not do until 2026-07-26 and which made the pre-commit gate lie.
#
#    `inst/bin/` is gitignored, so in a development checkout it is whatever the
#    previous `R CMD INSTALL` put there. Preferring it unconditionally meant that
#    once it existed, every later install shipped that engine no matter how far the
#    sources had moved: `R CMD INSTALL` printed `DONE (gog)` and the installed copy
#    refused a mark the engine beside it had drawn for hours. That is the stale
#    binary trap one artifact over, and it defeated the one check that is supposed
#    to prove an installed package works.
#
#    The fact that separates the two is not an mtime, it is *what you are
#    installing*: a release package tarball has no workspace beside it, and a
#    development checkout does. So a bundled engine is authoritative only when
#    there is nothing to rebuild it from.
if [ -f "${DEST}/${EXE}" ] && [ ! -f "${WORKSPACE}/Cargo.toml" ]; then
  echo "* gog: using the engine already in ${DEST}/"
  exit 0
fi

FOUND=""

# 2. An engine built elsewhere. A set GOG_CLI_PATH that names no file stops the
#    install rather than being passed over: the steps below would bundle an
#    engine nobody chose, and the package would then draw with it in silence.
if [ -n "${GOG_CLI_PATH}" ] && [ ! -f "${GOG_CLI_PATH}" ]; then
  echo "" >&2
  echo "gog: GOG_CLI_PATH is set to ${GOG_CLI_PATH}, and no file is there." >&2
  echo "Point it at the gog-cli file, or unset it so the install finds or builds" >&2
  echo "an engine by itself." >&2
  echo "" >&2
  exit 1
fi
if [ -n "${GOG_CLI_PATH}" ]; then
  FOUND="${GOG_CLI_PATH}"
else
  # 3. A development checkout: r-pkg/gog/ -> ../../target/
  for BUILD in release debug; do
    if [ -f "${WORKSPACE}/target/${BUILD}/${EXE}" ]; then
      FOUND="${WORKSPACE}/target/${BUILD}/${EXE}"
      break
    fi
  done
fi

# 4. Build it from the crate sources that came along with the repo — a
#    `remotes::install_github(…, build = FALSE)` install, where the tarball
#    carries the whole tree.
if [ -z "${FOUND}" ] && [ -f "${WORKSPACE}/Cargo.toml" ] && [ -f "${WORKSPACE}/gog-cli/Cargo.toml" ]; then
  choose_cargo "${WORKSPACE}"
  FOUND="$(build_engine "${WORKSPACE}")"
fi

# 5. Build it from the crate sources staged *inside* the package by `.prepare` — a
#    subdirectory build, which is how r-universe and the CRAN route both arrive.
#    There is no `../../` in that tarball, so this is the only source left.
if [ -z "${FOUND}" ] && [ -f "${STAGED}/Cargo.toml" ] && [ -f "${STAGED}/gog-cli/Cargo.toml" ]; then
  choose_cargo "${STAGED}"
  FOUND="$(build_engine "${STAGED}")"
fi

if [ -z "${FOUND}" ]; then
  echo "gog: this package carries the engine, and there is no engine to carry." >&2
  echo "" >&2
  # The cause first, when a build was what failed: it is the one paragraph here
  # that names the reader's own fix. `RUST_STATE` is empty when no source was
  # found to build from, and only then is the staging paragraph below the cause.
  RUSTUP_LINE="  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
  case "${RUST_STATE}" in
    old)
      echo "The engine is built from source here, which needs Rust ${RUST_FLOOR} or" >&2
      echo "newer, and every Rust found is older:" >&2
      printf '%s' "${RUST_SEEN}" >&2
      echo "" >&2
      echo "Install a current Rust with rustup, which needs no administrator rights:" >&2
      echo "${RUSTUP_LINE}" >&2
      echo "then install gog again. This step also looks in ~/.cargo/bin, where" >&2
      echo "rustup puts it, so nothing has to be added to PATH first." >&2
      echo "" >&2
      ;;
    none)
      echo "The engine is built from source here, which needs Rust${RUST_FLOOR:+ ${RUST_FLOOR} or newer}," >&2
      echo "and no Rust was found, on PATH or in ~/.cargo/bin. Install it with" >&2
      echo "rustup, which needs no administrator rights:" >&2
      echo "${RUSTUP_LINE}" >&2
      echo "then install gog again." >&2
      echo "" >&2
      ;;
    ok)
      # **A compiler the system stopped is not a build that failed.** The kernel
      # ends a process that takes more memory than the machine allows with
      # SIGKILL, and cargo reports it in those words. Posit Cloud did, at 0.5.0,
      # and the message here blamed the network.
      if grep -q 'SIGKILL' "${BUILD_LOG}" 2>/dev/null; then
        NAMED_CAUSE="memory"
        echo "The engine is built from source here, and the system stopped the" >&2
        echo "compiler partway through: \`SIGKILL\` in cargo's lines above. That is" >&2
        echo "almost always this machine running out of memory, since compiling the" >&2
        echo "engine needs more than it has free." >&2
        echo "" >&2
        PKG_VERSION="$(sed -n 's/^Version: *//p' DESCRIPTION | head -n 1)"
        case "$(uname -s)-$(uname -m)" in
          Linux-x86_64)               ASSET="linux-x64" ;;
          Linux-aarch64|Linux-arm64)  ASSET="linux-arm64" ;;
          Darwin-arm64)               ASSET="darwin-arm64" ;;
          Darwin-x86_64)              ASSET="darwin-x64" ;;
          *)                          ASSET="" ;;
        esac
        if [ -n "${ASSET}" ] && [ -n "${PKG_VERSION}" ]; then
          echo "Each release also carries the engine prebuilt, so nothing has to be" >&2
          echo "compiled. In R:" >&2
          echo "" >&2
          echo "  d <- file.path(tempdir(), \"gog-engine\"); dir.create(d)" >&2
          echo "  download.file(\"https://github.com/psychometrician/gog/releases/download/engine-v${PKG_VERSION}/gog-cli-${ASSET}.tar.gz\"," >&2
          echo "                file.path(d, \"engine.tgz\"), mode = \"wb\")" >&2
          echo "  untar(file.path(d, \"engine.tgz\"), exdir = d)" >&2
          echo "  Sys.chmod(file.path(d, \"gog-cli\"), \"755\")" >&2
          echo "  Sys.setenv(GOG_CLI_PATH = file.path(d, \"gog-cli\"))" >&2
          echo "" >&2
          echo "and then install gog again, in the same R session." >&2
        else
          echo "Point GOG_CLI_PATH at a prebuilt gog-cli and install gog again." >&2
        fi
        echo "" >&2
      else
        echo "The engine is built from source here, and the build with" >&2
        echo "${CARGO_BIN} did not finish. The lines cargo printed above say why." >&2
        echo "A build also needs a network connection, because cargo downloads the" >&2
        echo "engine's dependencies." >&2
        echo "" >&2
      fi
      ;;
  esac
  echo "None of the five sources had one:" >&2
  echo "  * a prebuilt engine in ${DEST}/" >&2
  echo "  * \$GOG_CLI_PATH" >&2
  echo "  * a build at ${WORKSPACE}/target/{release,debug}/" >&2
  echo "  * a source build from ${WORKSPACE}/ (the whole repository)" >&2
  echo "  * a source build from ${STAGED}/ (sources staged by .prepare)" >&2
  echo "" >&2
  # A build that ran out of memory has its fix named above, and building it
  # again is the one thing here that cannot work.
  if [ "${NAMED_CAUSE:-}" != "memory" ]; then
    echo "Fixes, cheapest first:" >&2
    echo "  Build it:        cargo build --release -p gog-cli" >&2
    echo "  Or point at one: GOG_CLI_PATH=/path/to/gog-cli R CMD INSTALL ..." >&2
    echo "  No Rust?         install it from https://rustup.rs/" >&2
    echo "" >&2
  fi
  # `remotes` writes these fields into DESCRIPTION before it builds, so they are
  # the one trace of how this tarball was made. With them present *and* no
  # workspace beside us, the tarball was packed from the package directory
  # alone, which is remotes' default (`build = TRUE`) and the case where the
  # generic message above would send a reader to install Rust they already have.
  if grep -q '^RemoteType: github' DESCRIPTION 2>/dev/null && [ ! -f "${WORKSPACE}/Cargo.toml" ]; then
    echo "This copy came through remotes::install_github(), and that is the cause." >&2
    echo "By default remotes packs the package directory alone into a tarball" >&2
    echo "before installing it, and the engine's sources sit beside that" >&2
    echo "directory, so they were left behind. Pass build = FALSE and remotes" >&2
    echo "installs from the whole tree instead:" >&2
    echo "" >&2
    echo "  remotes::install_github(\"psychometrician/gog\", subdir = \"r-pkg/gog\"," >&2
    echo "                          build = FALSE)" >&2
    echo "" >&2
  fi
  if [ -z "${RUST_STATE}" ]; then
    echo "If this is a subdirectory build (r-universe, or a CRAN-style tarball)," >&2
    echo "the likely cause is that .prepare did not run or did not finish: the" >&2
    echo "farm invokes it as \`|| true\`, so its failure is swallowed and surfaces" >&2
    echo "here instead. Check the build log for a \`gog/.prepare:\` line." >&2
    echo "" >&2
  fi
  echo "Installing without it would produce a package that cannot draw a plot," >&2
  echo "which is the failure this check exists to make loud." >&2
  exit 1
fi

mkdir -p "${DEST}"
cp "${FOUND}" "${DEST}/${EXE}"
chmod 0755 "${DEST}/${EXE}"
echo "* gog: bundled the engine from ${FOUND}"

# ---------------------------------------------------------------------------
# The browser engine, which is a different kind of thing from the one above
# ---------------------------------------------------------------------------
#
# A 3-D plot drawn into an HTML page can be turned with the mouse, and that needs
# the engine compiled to WebAssembly plus the small module that drives it. Both
# go to `inst/www/`, where `find_wasm_assets()` looks first.
#
# **Copied if present, never built, and absent is not an error.** Three reasons,
# and the first is the one that decides it: building it needs the
# `wasm32-unknown-unknown` target, which a user installing an R package has no
# reason to have and no obligation to install. Second, a missing browser engine
# costs a still picture rather than a broken one — `svg_block()` emits the static
# SVG it always did, which is what a PDF and a JavaScript-less viewer get anyway.
# Third, the engine that *draws* is required and this one is not, so failing here
# would refuse an install over a feature the user may never reach for.
#
# One file serves every platform, unlike `gog-cli`. WebAssembly is portable, so
# there is no per-platform matrix here and no question of which build to pick.
WASM_SRC="${WORKSPACE}/gog-wasm/target/wasm32-unknown-unknown/release/gog_wasm.wasm"
JS_SRC="${WORKSPACE}/js-pkg/gog/src/interactive.js"
WWW="inst/www"
VIEW_SRC="${WORKSPACE}/js-pkg/gog/src/view.js"
STAGED_VIEW="${STAGED}/view.js"

# **The view module is staged before any of this, and on its own terms.** It
# carries zoom, pan and fit for *every* plot and it asks the engine nothing, so
# gating it on a WebAssembly build would leave every flat plot without controls
# to protect the few that draw a cube. Nothing below can fail in a way that
# should cost a reader the ability to look closer.
mkdir -p "${WWW}"
if [ -f "${VIEW_SRC}" ]; then
  cp "${VIEW_SRC}" "${WWW}/view.js"
elif [ -f "${STAGED_VIEW}" ]; then
  cp "${STAGED_VIEW}" "${WWW}/view.js"
fi

if [ -f "${WWW}/gog.wasm" ] && [ -f "${WWW}/interactive.js" ] && [ ! -f "${WORKSPACE}/Cargo.toml" ]; then
  # A tarball that carries the browser engine prebuilt: `.prepare` stages it from
  # the release of this version, or from the checkout's own build before one
  # exists, so a Linux install with the system's Rust needs no wasm32 target.
  # Same test as the engine above: a checkout has a workspace beside it and a
  # tarball does not.
  echo "* gog: using the browser engine already in ${WWW}/"
elif [ -n "${GOG_CLI_PATH}" ] && [ "${FOUND}" = "${GOG_CLI_PATH}" ] \
     && [ -f "$(dirname "${GOG_CLI_PATH}")/gog.wasm" ] \
     && [ -f "$(dirname "${GOG_CLI_PATH}")/interactive.js" ]; then
  # **An engine downloaded from a release carries its browser engine beside it**,
  # built from the same sources in the same run. That download is what the
  # memory message above hands a small machine, and compiling the browser engine
  # instead would build `gog-core` a second time, on the machine that just ran
  # out of memory doing it once.
  BESIDE="$(dirname "${GOG_CLI_PATH}")"
  mkdir -p "${WWW}"
  cp "${BESIDE}/gog.wasm" "${WWW}/gog.wasm"
  cp "${BESIDE}/interactive.js" "${WWW}/interactive.js"
  echo "* gog: bundled the browser engine beside \$GOG_CLI_PATH — 3-D plots will turn in an HTML page"
elif [ -f "${WASM_SRC}" ] && [ -f "${JS_SRC}" ]; then
  mkdir -p "${WWW}"
  cp "${WASM_SRC}" "${WWW}/gog.wasm"
  cp "${JS_SRC}" "${WWW}/interactive.js"
  echo "* gog: bundled the browser engine — 3-D plots will turn in an HTML page"
elif [ -f "${STAGED}/gog-wasm/Cargo.toml" ] && [ -f "${STAGED}/interactive.js" ]; then
  # A staged source build — the r-universe and CRAN-style route, where the
  # sources travel and nothing is prebuilt. This is the only path that compiles
  # the browser engine, and **every failure in it is survivable**: no cargo, no
  # `wasm32-unknown-unknown` target, no network for `rustup target add`, a build
  # that dies. Each one leaves the package installable and its 3-D plots still.
  #
  # Which is why none of this is allowed to `set -e` its way out. The engine that
  # draws is required and already bundled by the time we get here; this one is an
  # improvement on a plot that is otherwise perfectly correct.
  echo "* gog: building the browser engine from the staged sources"
  # The cargo the engine was built with. An engine that came prebuilt or from
  # `GOG_CLI_PATH` never asked for one, so the choice is made here instead.
  [ -n "${RUST_STATE}" ] || choose_cargo "${STAGED}"
  if [ -n "${CARGO_BIN}" ]; then
    RUSTUP_BIN="$(command -v rustup || echo "${HOME}/.cargo/bin/rustup")"
    # `|| true`, because under `set -e` a failing last command of an `&&` list
    # ends the script: without it, a target rustup could not add (no network, or
    # a system-wide rustup this user cannot write to) failed the whole install
    # after the engine was already bundled.
    [ -x "${RUSTUP_BIN}" ] && "${RUSTUP_BIN}" target add wasm32-unknown-unknown >/dev/null 2>&1 || true
    # `-j 1`, for the reason the engine's own build gives: this compiles
    # `gog-core` a second time, for the browser.
    if PATH="${CARGO_PATH}" "${CARGO_BIN}" build --release --locked -j 1 \
         --target wasm32-unknown-unknown \
         --manifest-path "${STAGED}/gog-wasm/Cargo.toml" > "${BUILD_LOG}" 2>&1; then
      BUILT="${STAGED}/gog-wasm/target/wasm32-unknown-unknown/release/gog_wasm.wasm"
      if [ -f "${BUILT}" ]; then
        mkdir -p "${WWW}"
        cp "${BUILT}" "${WWW}/gog.wasm"
        cp "${STAGED}/interactive.js" "${WWW}/interactive.js"
        echo "* gog: built the browser engine — 3-D plots will turn in an HTML page"
      fi
    fi
  fi
  if [ ! -f "${WWW}/gog.wasm" ]; then
    # The cause, when cargo's output names one: the system stopping the compiler
    # is memory, not a missing target, as it is for the engine's own build.
    if grep -q 'SIGKILL' "${BUILD_LOG}" 2>/dev/null; then
      echo "* gog: the system stopped the compiler building the browser engine, most"
      echo "       likely for lack of memory; 3-D plots will draw as still pictures."
      echo "       Everything else is unaffected."
    else
      echo "* gog: could not build the browser engine (no wasm32 target?);"
      echo "       3-D plots will draw as still pictures. Everything else is unaffected."
    fi
  fi
else
  echo "* gog: no browser engine found; 3-D plots will draw as still pictures."
  echo "       To include it:  cargo build --release --target wasm32-unknown-unknown \\"
  echo "                         --manifest-path gog-wasm/Cargo.toml"
fi
